# ==============================================================================
# SmartFactory IoT - Variáveis de Ambiente e Limites Operacionais
# Disciplina: Distribuição e Concorrência (PUC)
#
# Fonte única de configuração: carregado pelo docker-compose (env_file), pelo
# Makefile (include) e pelos scripts em scripts/ (source). Formato KEY=VALUE,
# sem aspas e sem espaços ao redor do "=".
# ==============================================================================

# --- Conexão com o Cluster Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPIC=dados-sensores
KAFKA_GROUP_ID=smartfactory-processors

# --- Topologia do tópico (usada por make create-topic e pelos testes) ---
# Devem ser coerentes com a configuração dos brokers em docker-compose.yml.
TOPIC_PARTITIONS=3
TOPIC_REPLICATION_FACTOR=3
TOPIC_MIN_INSYNC_REPLICAS=2

# --- Limites Críticos de Telemetria (Detecção de Anomalias) ---
# Temperatura em graus Celsius (°C)
WARN_TEMP=75.0
MAX_TEMP=85.0

# Vibração em milímetros por segundo (mm/s)
WARN_VIBRATION=4.0
MAX_VIBRATION=5.0

# Consumo de Energia Elétrica em Kilowatts (kW)
WARN_POWER_KW=25.0
MAX_POWER_KW=30.0

# --- Parâmetros de Simulação dos Sensores IoT ---
INTERVALO_ENVIO_SEG=2.0
CHANCE_ANOMALIA_PERCENTUAL=15
# Leituras anômalas ficam entre MAX_* x FATOR_MIN e MAX_* x FATOR_MAX
ANOMALIA_FATOR_MIN=1.02
ANOMALIA_FATOR_MAX=1.5
# Ruído gaussiano (desvio padrão) da operação nominal
RUIDO_TEMPERATURA=2.0
RUIDO_VIBRACAO=0.4
RUIDO_POTENCIA_KW=1.5

# --- Produtor Kafka ---
PRODUCER_ACKS=all
PRODUCER_RETRIES=5
# Lotes não confirmados por mais que isso são descartados. Deve superar o tempo de
# failover do líder do quórum KRaft (medido entre 13 e 26 s nos testes de falha de broker).
PRODUCER_REQUEST_TIMEOUT_MS=45000
# Renovação periódica dos metadados: sem isso o cliente Python pode ficar apontando
# para um líder de partição morto (metadados obtidos durante a eleição do controlador).
PRODUCER_METADATA_MAX_AGE_MS=10000

# --- Consumidor Kafka ---
AUTO_OFFSET_RESET=earliest
AUTO_COMMIT_INTERVAL_MS=2000
SESSION_TIMEOUT_MS=10000
HEARTBEAT_INTERVAL_MS=3000
MAX_POLL_INTERVAL_MS=300000
# Renovação periódica dos metadados (líderes de partição). Sem isso, após a queda
# abrupta do líder do quórum o consumidor continua buscando no broker morto.
CONSUMER_METADATA_MAX_AGE_MS=10000
POLL_TIMEOUT_MS=1000
POLL_MAX_RECORDS=50
# PROCESSING_DELAY_MS (custo simulado por mensagem, padrão 0) é definido em
# docker-compose.yml, para poder ser sobrescrito por execução no teste de elasticidade.

# --- Reconexão ao Kafka (backoff exponencial limitado) ---
CONNECT_MAX_RETRIES=30
CONNECT_RETRY_DELAY_SEG=3.0
CONNECT_RETRY_MAX_DELAY_SEG=30.0

# --- Configuração de Armazenamento e Logs ---
ALERT_LOG_PATH=/var/log/smartfactory/alerts.log
